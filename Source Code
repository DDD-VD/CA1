/*
   Wake up every second, check the distance
   If a hand is detected, activate the servo, turn it, record the time, then go back to sleep every second
   If no hand is detected and the hold time has passed, activate the servo and close the lid
*/
//--------------------SETTINGS----------------------
         // activation height
#define cap_time 2      // time the lid stays open in seconds
#define open_angle -10   // opening angle
#define close_angle 120  // closing angle

#define debug 0        // output debug information to the port (0 off, 1 on)
//--------------------SETTINGS----------------------

// ---CONNECTION---
#define IRsensor 4
//#define sensorVCC 4
#define servoPin 7
// ---CONNECTION---

#include "LowPower.h" // sleep library
#include <Servo.h> // library for working with the servo motor
#include <Arduino.h>
#include  <rgb_lcd.h>

Servo servo;          // declare a servo variable of type Servo
rgb_lcd lcd;          // declare an lcd variable of type rgb_lcd
long duration;

unsigned long open_timer;
bool open_flag;
bool IRsensor_flag;

//////////////////////
void open_cap() {
  servo.write(open_angle);        // open the lid
  delay(500);                    // wait for the servo
  lcd.print("Open");
  open_flag = 1;
  digitalWrite(8, HIGH);         // turn on the sensor
                                 // flag indicating the lid is open
}
void close_cap() {
  servo.write(close_angle);       // close the lid
  delay(500);                    // wait for the servo
  lcd.print("Close");
  open_flag = 0;
  digitalWrite(8, LOW);          // flag indicating the lid is closed
  delay(50);
  lcd.clear();
}
////////////////////////////
void setup() {
  Serial.begin(9600);
  Serial.println("system start");
  lcd.begin(16, 2);

  if (debug) Serial.println("system start");
  servo.attach(servoPin);         // servo on pin 5
  pinMode(IRsensor, INPUT);       // IR sensor on pin 7
  pinMode(8, OUTPUT);            // power pin as output
                                 // power pin as output
                                 // turn off the sensor

  open_cap();                     // open the lid on startup
}

void loop() {
  lcd.display();
   
  LowPower.powerDown(SLEEP_1S, ADC_OFF, BOD_OFF);  // sleep for 1 second

  IRsensor_flag = !digitalRead(IRsensor);         // get distance reading

  /*if (debug) {
    Serial.println(IRsensor);
    delay(500);
  }  */

  if (IRsensor_flag) { // if distance is within range
    open_timer = 0;                     // reset timer
    if (!open_flag) {                   // if the lid is closed
      open_cap();                        // open the lid
    }
  }
  else {
    if (open_flag) {                    // if the lid is open
      open_timer++;                     // increase timer
      if (open_timer > cap_time) {      // if more than cap_time seconds have passed since opening
        close_cap();                    // close the lid
      }
    }
  }
  lcd.noDisplay();
}
